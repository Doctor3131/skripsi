NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-secret
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO

# Opsional: isi hanya dengan akun Neo4j yang benar-benar punya hak baca saja.
# Neo4j Community Edition tidak mendukung role read-only terpisah.
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=

# Endpoint wajib kompatibel dengan OpenAI Chat Completions.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
