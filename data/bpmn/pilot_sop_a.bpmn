<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_cuti" targetNamespace="https://fsm.undip.ac.id/graphrag/bpmn/pilot/cuti-akademik/v1" exporter="FSM GraphRAG deterministic pilot generator" exporterVersion="0.1"><bpmn:process id="Process_CutiAkademik" name="Permohonan Izin Cuti Akademik" isExecutable="false"><bpmn:documentation>ID SOP proyek: FSM-SOP-CUTI-AKADEMIK. ID model: FSM-SOP-CUTI-AKADEMIK-BPMN-v1. Versi sumber: header-created-2024-12-24_revision-not-stated. PDF acuan: SOP_Izin_Cuti_Akademik.pdf (SHA-256 4b01cc7e3916d21c6294bf269d7d0b5061a48675b228421e4329559ca15a81d5). Tabel pelengkap: SOP Permohonan Izin Cuti Akademik_rev.docx (SHA-256 11204afb53e39709a193e75ecddd6238f30df999b6fdee8096c4275c884d4828). Waktu pemrosesan maksimal: tiga hari kerja. PDF menjadi acuan urutan dan kondisi. Tabel DOCX melengkapi informasi pelaksana. Metadata pengesahan DOCX yang menyebut Rektor dicatat sebagai konflik metadata; aktivitas penandatanganan mengikuti uraian proses PDF yang menyebut Dekan.</bpmn:documentation><bpmn:laneSet id="LaneSet_cuti"><bpmn:lane id="Lane_Mahasiswa" name="Mahasiswa"><bpmn:flowNodeRef>Start_Cuti</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_IsiFormCuti</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MintaPersetujuanProdi</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SerahkanKeDekan</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PilihanPengambilan</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AmbilSuratCuti</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cuti_Diambil</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubbagAkademik" name="Subbag Akademik dan Kemahasiswaan"><bpmn:flowNodeRef>Task_PeriksaKelengkapan</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PerbaruiStatus</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Dekan" name="Dekan"><bpmn:flowNodeRef>Task_TandaTanganDekan</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubbagSumberDaya" name="Subbag Sumber Daya"><bpmn:flowNodeRef>Task_BeriNomorSurat</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Cuti" name="Pengajuan cuti dimulai"><bpmn:documentation>Penanda awal proses untuk memodelkan delapan langkah SOP.</bpmn:documentation></bpmn:startEvent><bpmn:userTask id="Task_IsiFormCuti" name="Mengunduh, mengisi, dan menandatangani Form Cuti; mengisi SIAP"><bpmn:documentation>Mahasiswa melampirkan seluruh persyaratan yang disebut dalam objek data.</bpmn:documentation><bpmn:ioSpecification id="Io_Task_IsiFormCuti"><bpmn:dataInputs id="Inputs_Task_IsiFormCuti"><bpmn:dataInput id="Input_BerkasCuti" name="Berkas persyaratan cuti" /></bpmn:dataInputs><bpmn:inputSets id="InputSets_Task_IsiFormCuti"><bpmn:inputSet id="InputSet_Task_IsiFormCuti"><bpmn:dataInputRefs>Input_BerkasCuti</bpmn:dataInputRefs></bpmn:inputSet></bpmn:inputSets><bpmn:outputSets id="OutputSets_Task_IsiFormCuti"><bpmn:outputSet id="OutputSet_Task_IsiFormCuti" /></bpmn:outputSets></bpmn:ioSpecification><bpmn:dataInputAssociation id="DA_Task_IsiFormCuti_Input_BerkasCuti"><bpmn:sourceRef>Ref_BerkasPersyaratanCuti</bpmn:sourceRef><bpmn:targetRef>Input_BerkasCuti</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:userTask id="Task_MintaPersetujuanProdi" name="Meminta persetujuan dan tanda tangan Ketua Program Studi" /><bpmn:userTask id="Task_SerahkanKeDekan" name="Menyerahkan Form Cuti yang telah ditandatangani kepada Dekan"><bpmn:documentation>Langkah yang sama menyatakan bahwa formulir kemudian didisposisikan ke Subbag Akademik dan Kemahasiswaan.</bpmn:documentation></bpmn:userTask><bpmn:userTask id="Task_PeriksaKelengkapan" name="Memeriksa kelengkapan; memberi paraf dan memproses bila lengkap"><bpmn:documentation>PDF menyatakan proses berlanjut jika persyaratan lengkap. SOP tidak menjelaskan hasil untuk persyaratan yang tidak lengkap.</bpmn:documentation></bpmn:userTask><bpmn:userTask id="Task_TandaTanganDekan" name="Menandatangani Surat Izin Dekan"><bpmn:ioSpecification id="Io_Task_TandaTanganDekan"><bpmn:dataOutputs id="Outputs_Task_TandaTanganDekan"><bpmn:dataOutput id="Output_SuratIzinDekan" name="Surat Izin Dekan" /></bpmn:dataOutputs><bpmn:inputSets id="InputSets_Task_TandaTanganDekan"><bpmn:inputSet id="InputSet_Task_TandaTanganDekan" /></bpmn:inputSets><bpmn:outputSets id="OutputSets_Task_TandaTanganDekan"><bpmn:outputSet id="OutputSet_Task_TandaTanganDekan"><bpmn:dataOutputRefs>Output_SuratIzinDekan</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:outputSets></bpmn:ioSpecification><bpmn:dataOutputAssociation id="DA_Task_TandaTanganDekan_Output_SuratIzinDekan"><bpmn:sourceRef>Output_SuratIzinDekan</bpmn:sourceRef><bpmn:targetRef>Ref_SuratIzinDekan</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:userTask id="Task_BeriNomorSurat" name="Memberi nomor surat dan mengirimkannya beserta tembusan"><bpmn:documentation>Tembusan dikirim kepada Dosen Wali dan Ketua Program Studi.</bpmn:documentation><bpmn:ioSpecification id="Io_Task_BeriNomorSurat"><bpmn:dataInputs id="Inputs_Task_BeriNomorSurat"><bpmn:dataInput id="Input_SuratUntukNomor" name="Surat Izin Dekan" /></bpmn:dataInputs><bpmn:inputSets id="InputSets_Task_BeriNomorSurat"><bpmn:inputSet id="InputSet_Task_BeriNomorSurat"><bpmn:dataInputRefs>Input_SuratUntukNomor</bpmn:dataInputRefs></bpmn:inputSet></bpmn:inputSets><bpmn:outputSets id="OutputSets_Task_BeriNomorSurat"><bpmn:outputSet id="OutputSet_Task_BeriNomorSurat" /></bpmn:outputSets></bpmn:ioSpecification><bpmn:dataInputAssociation id="DA_Task_BeriNomorSurat_Input_SuratUntukNomor"><bpmn:sourceRef>Ref_SuratIzinDekan</bpmn:sourceRef><bpmn:targetRef>Input_SuratUntukNomor</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:userTask id="Task_PerbaruiStatus" name="Memperbarui status mahasiswa, mengarsipkan, dan mengirim surat"><bpmn:ioSpecification id="Io_Task_PerbaruiStatus"><bpmn:dataInputs id="Inputs_Task_PerbaruiStatus"><bpmn:dataInput id="Input_SuratUntukArsip" name="Surat Izin Dekan" /></bpmn:dataInputs><bpmn:inputSets id="InputSets_Task_PerbaruiStatus"><bpmn:inputSet id="InputSet_Task_PerbaruiStatus"><bpmn:dataInputRefs>Input_SuratUntukArsip</bpmn:dataInputRefs></bpmn:inputSet></bpmn:inputSets><bpmn:outputSets id="OutputSets_Task_PerbaruiStatus"><bpmn:outputSet id="OutputSet_Task_PerbaruiStatus" /></bpmn:outputSets></bpmn:ioSpecification><bpmn:dataInputAssociation id="DA_Task_PerbaruiStatus_Input_SuratUntukArsip"><bpmn:sourceRef>Ref_SuratIzinDekan</bpmn:sourceRef><bpmn:targetRef>Input_SuratUntukArsip</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_PilihanPengambilan" name="Mahasiswa memilih mengambil surat di loket?" default="Flow_Cuti_TidakDiambil"><bpmn:documentation>Kata ‘dapat’ ditafsirkan sebagai pilihan; tafsir ini perlu review PI.</bpmn:documentation></bpmn:exclusiveGateway><bpmn:userTask id="Task_AmbilSuratCuti" name="Mengambil Surat Izin Dekan di loket akademik"><bpmn:ioSpecification id="Io_Task_AmbilSuratCuti"><bpmn:dataInputs id="Inputs_Task_AmbilSuratCuti"><bpmn:dataInput id="Input_SuratUntukDiambil" name="Surat Izin Dekan" /></bpmn:dataInputs><bpmn:inputSets id="InputSets_Task_AmbilSuratCuti"><bpmn:inputSet id="InputSet_Task_AmbilSuratCuti"><bpmn:dataInputRefs>Input_SuratUntukDiambil</bpmn:dataInputRefs></bpmn:inputSet></bpmn:inputSets><bpmn:outputSets id="OutputSets_Task_AmbilSuratCuti"><bpmn:outputSet id="OutputSet_Task_AmbilSuratCuti" /></bpmn:outputSets></bpmn:ioSpecification><bpmn:dataInputAssociation id="DA_Task_AmbilSuratCuti_Input_SuratUntukDiambil"><bpmn:sourceRef>Ref_SuratIzinDekan</bpmn:sourceRef><bpmn:targetRef>Input_SuratUntukDiambil</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:endEvent id="End_Cuti_Terkirim" name="Surat telah dikirim; proses layanan selesai"><bpmn:documentation>Jalur selesai setelah surat dikirim apabila mahasiswa tidak mengambilnya di loket.</bpmn:documentation></bpmn:endEvent><bpmn:endEvent id="End_Cuti_Diambil" name="Surat Izin Dekan diambil mahasiswa"><bpmn:documentation>Hasil jalur pilihan jika mahasiswa mengambil surat di loket.</bpmn:documentation></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Cuti_00_01" sourceRef="Start_Cuti" targetRef="Task_IsiFormCuti"><bpmn:documentation>Batas proses</bpmn:documentation></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Cuti_01_02" sourceRef="Task_IsiFormCuti" targetRef="Task_MintaPersetujuanProdi" /><bpmn:sequenceFlow id="Flow_Cuti_02_03" sourceRef="Task_MintaPersetujuanProdi" targetRef="Task_SerahkanKeDekan" /><bpmn:sequenceFlow id="Flow_Cuti_03_04" sourceRef="Task_SerahkanKeDekan" targetRef="Task_PeriksaKelengkapan" name="Kemudian didisposisikan ke Subbag Akademik dan Kemahasiswaan"><bpmn:documentation>Setelah penyerahan, formulir didisposisikan ke Subbag Akademik dan Kemahasiswaan; pelaksana disposisi tidak disebutkan.</bpmn:documentation></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Cuti_Lengkap" sourceRef="Task_PeriksaKelengkapan" targetRef="Task_TandaTanganDekan" name="Jika persyaratan lengkap"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">persyaratan lengkap</bpmn:conditionExpression><bpmn:documentation>Satu-satunya kelanjutan bersyarat yang disebutkan. Tidak ada alur untuk persyaratan tidak lengkap.</bpmn:documentation></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Cuti_05_06" sourceRef="Task_TandaTanganDekan" targetRef="Task_BeriNomorSurat" /><bpmn:sequenceFlow id="Flow_Cuti_06_07" sourceRef="Task_BeriNomorSurat" targetRef="Task_PerbaruiStatus" /><bpmn:sequenceFlow id="Flow_Cuti_07_08" sourceRef="Task_PerbaruiStatus" targetRef="Gateway_PilihanPengambilan"><bpmn:documentation>SOP mengirim surat kepada mahasiswa, lalu menyebut bahwa mahasiswa dapat mengambilnya di loket.</bpmn:documentation></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Cuti_PilihDiambil" sourceRef="Gateway_PilihanPengambilan" targetRef="Task_AmbilSuratCuti" name="Jika mahasiswa memilih mengambil surat"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mahasiswa memilih mengambil surat di loket</bpmn:conditionExpression><bpmn:documentation>Pilihan ini ditafsirkan dari kata ‘dapat’; perlu review PI.</bpmn:documentation></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Cuti_TidakDiambil" sourceRef="Gateway_PilihanPengambilan" targetRef="End_Cuti_Terkirim" name="Surat dikirim; tidak diambil di loket"><bpmn:documentation>Alur bawaan yang menutup proses setelah pengiriman; tidak menambah tugas/kegagalan baru.</bpmn:documentation></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Cuti_08_Selesai" sourceRef="Task_AmbilSuratCuti" targetRef="End_Cuti_Diambil" /><bpmn:dataObject id="Object_BerkasPersyaratanCuti" name="Persyaratan: Form Cuti, transkrip, bukti SPP/UKT terakhir, fotokopi KTM, dan dokumen pendukung" /><bpmn:dataObjectReference id="Ref_BerkasPersyaratanCuti" dataObjectRef="Object_BerkasPersyaratanCuti" name="Persyaratan: Form Cuti, transkrip, bukti SPP/UKT terakhir, fotokopi KTM, dan dokumen pendukung" /><bpmn:dataObject id="Object_SuratIzinDekan" name="Surat Izin Dekan" /><bpmn:dataObjectReference id="Ref_SuratIzinDekan" dataObjectRef="Object_SuratIzinDekan" name="Surat Izin Dekan" /></bpmn:process><bpmn:collaboration id="Collaboration_cuti"><bpmn:participant id="Participant_cuti" name="Permohonan Izin Cuti Akademik" processRef="Process_CutiAkademik" /></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram_cuti"><bpmndi:BPMNPlane id="Plane_cuti" bpmnElement="Process_CutiAkademik"><bpmndi:BPMNShape id="DI_Lane_Mahasiswa" bpmnElement="Lane_Mahasiswa"><dc:Bounds x="35" y="105" width="3010" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_SubbagAkademik" bpmnElement="Lane_SubbagAkademik"><dc:Bounds x="35" y="330" width="3010" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_Dekan" bpmnElement="Lane_Dekan"><dc:Bounds x="35" y="555" width="3010" height="210" /></bpmndi:BPMNShape><bpmnd